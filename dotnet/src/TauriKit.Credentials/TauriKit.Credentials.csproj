<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>TauriKit.Credentials</PackageId>
    <Description>Secrets in the Windows Credential Manager under the same entries the tauri-kit-credentials crate uses — the same names and the same separation of test, development and release builds — so a desktop app's shell and its .NET backend can share one secret.</Description>
    <PackageTags>tauri;credentials;secrets;credential-manager;desktop</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!-- MIT asks that its notice travel with each copy; the expression alone does not carry it. -->
    <None Include="..\..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TauriKit.Credentials.Tests" />
  </ItemGroup>

</Project>
