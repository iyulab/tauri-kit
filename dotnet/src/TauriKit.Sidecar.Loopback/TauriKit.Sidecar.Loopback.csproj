<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>TauriKit.Sidecar.Loopback</PackageId>
    <Description>The framework-free half of a desktop app's loopback backend: the owner-only discovery file (publish, read, stale rule), the credentials a backend accepts and who holds each, the fault record, and a caller's HttpClient handler that finds the backend by its file. No ASP.NET Core — the host half is TauriKit.Sidecar.Loopback.AspNetCore. Pairs with the tauri-kit-sidecar crate's loopback feature.</Description>
    <PackageTags>tauri;sidecar;loopback;desktop</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Sidecars are often published ahead-of-time compiled; the analyzers keep this library usable there. -->
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!-- MIT asks that its notice travel with each copy; the expression alone does not carry it. -->
    <None Include="..\..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TauriKit.Sidecar.Loopback.Tests" />
  </ItemGroup>

</Project>
